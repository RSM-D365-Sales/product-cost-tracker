# ---------------------------------------------------------------------------
# D365 Finance and Operations connection
# ---------------------------------------------------------------------------
# Environment base URL, no trailing slash.
D365_URL=https://yourenv.sandbox.operations.dynamics.com

# Azure AD app registration used for the server-to-server connection.
# The same app must be registered in F&O under
#   System administration > Setup > Microsoft Entra ID applications
# with a user ID that has the required duties.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# Legal entity used when the client does not supply one.
D365_COMPANY=USMF

# ---------------------------------------------------------------------------
# Custom service (only needed when VITE_DATA_PROVIDER=service)
# ---------------------------------------------------------------------------
# Path segment after /api/services/ — {ServiceGroup}/{Service}/{Operation}
D365_SERVICE_PATH=RSMProductCostServiceGroup/RSMProductCostInquiryService/getProductCost
# Name of the X++ method parameter that receives the request contract.
D365_SERVICE_PARAM=_request

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
PORT=8787
# Comma-separated list of browser origins allowed to call this proxy.
ALLOWED_ORIGINS=http://localhost:5173
