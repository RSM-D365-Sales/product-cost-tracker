# Which data provider the app uses. One of: mock | odata | service
#   mock    - seeded in-browser data, no network. Demo-ready offline.
#   odata   - standard D365 data entities via the Node proxy, joined client-side.
#   service - custom X++ service via the Node proxy, pre-joined server-side.
VITE_DATA_PROVIDER=mock

# Base path for the Node proxy. Left relative so the Vite dev proxy and any
# reverse proxy in front of a deployed build both work unchanged.
VITE_API_BASE=/api

# Legal entity / company to query. Becomes the OData cross-company filter.
VITE_COMPANY=USMF

# The dark "Finance and Operations" navigation bar is HIDDEN by default — the
# app is built to be embedded inside a real F&SC workspace (iframe / website
# host control). Set to 0 to build with the standalone chrome instead. The
# same can be done per-URL without a rebuild by appending ?embed=0 —
# e.g. .../index.html?embed=0#/product-cost
#VITE_EMBED=0
